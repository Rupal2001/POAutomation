# Required. Local Homebrew example (replace YOUR_MAC_USERNAME with `id -un`):
DATABASE_URL=postgresql://YOUR_MAC_USERNAME@127.0.0.1:5432/po_ledger
# Remote deployment currently supports Neon-hosted PostgreSQL through its
# serverless driver. Generic RDS/Supabase URLs need a separate driver path.
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Required for signed user sessions. Generate with: openssl rand -hex 32
AUTH_SECRET=

# On an empty localhost database, `npm run db:init` creates admin/admin and
# requires a password change after first sign-in. Remote and production
# databases never use that default; provide explicit bootstrap credentials.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_DISPLAY_NAME=Administrator
BOOTSTRAP_ADMIN_EMAIL=

# Purchase-order email. `preview` is the safe local default: it exercises and
# audits the workflow but sends nothing. Use `resend` only after configuring
# the three delivery values below and verifying the sender domain.
EMAIL_PROVIDER=preview
EMAIL_FROM=
EMAIL_REPLY_TO=
RESEND_API_KEY=

# Optional safety route: in resend mode, redirect every message to these test
# recipients instead of its intended supplier. Separate addresses with commas.
EMAIL_FORCE_TO=

# Optional. Set true only after an external cron/scheduler is actually wired.
AUTOMATION_SCHEDULER_CONNECTED=false
